# Generated by `make arch-package`; do not replace the @...@ values manually.
pkgname=plainshow-cluster
pkgver=@VERSION@
pkgrel=1
pkgdesc='Peer-to-peer AI task cluster and collaborative PlainShow workspace'
arch=('@ARCH@')
url='https://github.com/huggan360/plainshow-cluster'
license=('custom')
depends=('ca-certificates' 'git' 'tailscale' 'util-linux' 'jupyter-server')
provides=('plainshow-cluster')
conflicts=('plainshow-cluster-git')
options=('!debug')
install=plainshow-cluster.install
source=('pscluster.seed' 'pscluster-wrapper' 'plainshow-cluster.service')
sha256sums=('@BINARY_SHA256@' '@WRAPPER_SHA256@' '@SERVICE_SHA256@')

package() {
    install -Dm755 "$srcdir/pscluster.seed" \
        "$pkgdir/usr/lib/plainshow-cluster/pscluster"
    install -Dm755 "$srcdir/pscluster-wrapper" "$pkgdir/usr/bin/pscluster"
    install -Dm644 "$srcdir/plainshow-cluster.service" \
        "$pkgdir/usr/lib/systemd/system/plainshow-cluster.service"
}
