# _install_ray puts Ray in a virtual environment inside the node's own root.
# Arch does not package Ray, and a system-wide pip install is refused, so the
# node keeps its own. A failure here is a warning: the node is useful before
# anybody runs anything.
_install_ray() {
    local ray_version=2.58.0
    if [[ -x /opt/plainshow-cluster/runtime/bin/python ]] &&
       /opt/plainshow-cluster/runtime/bin/python -c \
           "import ray; raise SystemExit(0 if ray.__version__ == '$ray_version' else 1)" 2>/dev/null; then
        return 0
    fi
    echo 'Installing Ray for Plainshow Cluster...'
    if ! python3 -m venv /opt/plainshow-cluster/runtime 2>/dev/null ||
       ! /opt/plainshow-cluster/runtime/bin/pip install --quiet --upgrade pip ||
       ! /opt/plainshow-cluster/runtime/bin/pip install --quiet --upgrade "ray[default]==$ray_version" ||
       ! /opt/plainshow-cluster/runtime/bin/python -c \
           "import ray; raise SystemExit(0 if ray.__version__ == '$ray_version' else 1)"; then
        echo 'Ray could not be installed in /opt/plainshow-cluster/runtime. Run:' >&2
        echo "  sudo /opt/plainshow-cluster/runtime/bin/pip install 'ray[default]==$ray_version'" >&2
        return 1
    fi
}

_prepare_workspace() {
    local workspace_user="${SUDO_USER:-${PSCLUSTER_WORKSPACE_USER:-}}"
    if [[ -n "$workspace_user" && "$workspace_user" != root ]]; then
        /opt/plainshow-cluster/bin/pscluster workspace --root /opt/plainshow-cluster --user "$workspace_user" ||
            echo 'Project migration was not completed. Existing files were retained; see the message above.'
    else
        echo 'To place projects in your home: sudo pscluster workspace --root /opt/plainshow-cluster --user YOUR_USERNAME (stop the node first).'
    fi
}

post_install() {
    local ray_status=0
    install -d -m 0755 /opt/plainshow-cluster/bin
    install -m 0755 /usr/lib/plainshow-cluster/pscluster \
        /opt/plainshow-cluster/bin/pscluster
    if [[ ! -f /opt/plainshow-cluster/config.yaml ]]; then
        PSCLUSTER_ACCOUNT_SERVER=https://clusteradmin.plainshow.se \
            /opt/plainshow-cluster/bin/pscluster init --root /opt/plainshow-cluster
    fi

    _prepare_workspace
    _install_ray || ray_status=$?

    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
        systemctl enable --now tailscaled.service
        systemctl enable --now plainshow-cluster.service
    fi

	if ! tailscale status >/dev/null 2>&1; then
		echo 'Plainshow Cluster installed. Open it from the application menu and sign in; private networking connects automatically.'
	else
        echo 'Plainshow Cluster installed and started.'
    fi
    return "$ray_status"
}

post_upgrade() {
    local ray_status=0
    if [[ -d /run/systemd/system ]]; then
        systemctl stop plainshow-cluster.service || true
    fi
    install -d -m 0755 /opt/plainshow-cluster/bin
    install -m 0755 /usr/lib/plainshow-cluster/pscluster \
        /opt/plainshow-cluster/bin/pscluster
    _prepare_workspace
    _install_ray || ray_status=$?
    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
        systemctl start plainshow-cluster.service || true
    fi
    return "$ray_status"
}

pre_remove() {
    if [[ -d /run/systemd/system ]]; then
        systemctl disable --now plainshow-cluster.service || true
    fi
}

post_remove() {
    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
    fi
    echo 'Plainshow Cluster node data remains in /opt/plainshow-cluster.'
    echo 'To remove it as well:  sudo rm -rf /opt/plainshow-cluster'
}
