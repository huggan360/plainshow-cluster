#!/bin/sh
set -eu

case "${1:-}" in
    version|--version|-v|help|--help|-h)
        exec "$SNAP/bin/pscluster" "$@"
        ;;
esac

# The snap owns one system node in SNAP_COMMON. Its CLI credential is
# deliberately root-only, just like /opt/plainshow-cluster in distro installs.
if [ "$(id -u)" -ne 0 ]; then
    echo "Plainshow Cluster's snap node is system-owned." >&2
    echo "Run this command with sudo, for example:" >&2
    echo "  sudo plainshow-cluster.pscluster ${*:-status}" >&2
    exit 1
fi

exec "$SNAP/bin/pscluster" "$@" --root "$SNAP_COMMON/node"
